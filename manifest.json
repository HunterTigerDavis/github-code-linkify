{
    "manifest_version": 3,
    "name": "Github Link Clicker Extension",
    "author": "Hunter Tiger Davis",
    "version": "0.1",
    "action": {
        "default_popup": "index.html",
        "default_icon": {
            "64": "icons/icon64.png",
            "128": "icons/icon128.png"
        }
    },
    "permissions": [
        "scripting",
        "tabs",
        "notifications"
    ],
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": [ "https://github.com/*" ],
            "js": ["content.js"],
            "run_at": "document_end"
        }
    ],
    "host_permissions": [
        "https://*.github.com/*",
        "https://*.gitlab.com/*",
        "https://*.bitbucket.org/*",
        "http://*/*/",
        "https://*/*/"
    ],
    "icons": {
        "64": "icons/icon64.png",
        "128": "icons/icon128.png"
    }
}