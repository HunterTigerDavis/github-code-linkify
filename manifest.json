{
    "manifest_version": 3,
    "name": "Github Link Clicker Extension",
    "author": "Hunter Tiger Davis",
    "version": "0.1",
    "action": {
        "default_popup": "index.html"
    },
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "permissions": [
        "tabs",
        "storage",
        "notifications"
    ],
    "icons": {
        "64": "icons/icon64.png",
        "128": "icons/icon128.png"
    }
}