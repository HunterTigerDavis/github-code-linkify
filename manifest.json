{
    "manifest_version": 3,
    "name": "Github Link Clicker Extension",
    "author": "Hunter Tiger Davis",
    "version": "0.1",
    "action": {
        "default_popup": "index.html"
    },
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "host_permissions": [
        "http://github.com/*",
        "http://*/*/",
        "https://*/*/"
    ],
    "permissions": [
        "scripting", // needed to execute scripts in the context of the page
        "tabs"
        // "storage",
        // "notifications"
        // TODO: permissions for scanning PR page to compile links
        
    ],
    "icons": {
        "64": "icons/icon64.png",
        "128": "icons/icon128.png"
    }
}